[Unit]
Description=NIMA: Epochs, a shared evolving ocean
After=network.target

[Service]
Type=simple
User=nima-epochs
Group=nima-epochs
WorkingDirectory=/opt/nima-epochs
Environment=NODE_ENV=production
EnvironmentFile=-/etc/nima-epochs.env
Environment=EPOCHS_DATA_DIR=/var/lib/nima-epochs
Environment=EPOCHS_PORT=8090
Environment=EPOCHS_HOST=127.0.0.1
Environment=EPOCHS_WARMUP_SECONDS=3600
Environment=EPOCHS_WORLD=1536
Environment=EPOCHS_ISLANDS=7
ExecStart=/usr/bin/node --max-old-space-size=320 server.mjs
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
MemoryMax=512M
CPUQuota=40%
Nice=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/nima-epochs

[Install]
WantedBy=multi-user.target
